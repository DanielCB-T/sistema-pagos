# Copia este archivo a ".env" y ajusta los valores
NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=sistema_pagos
PGUSER=postgres
PGPASSWORD=cambia_esta_clave

# Seguridad (JWT_SECRET: cadena larga y aleatoria, mínimo 32 caracteres)
JWT_SECRET=
SESSION_HOURS=8
# Poner en true solo si se sirve por HTTPS
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=10

# Solo para "npm run seed" (usuario administrador inicial)
ADMIN_USER=admin
# Si se deja vacío, el seed genera una contraseña aleatoria y la muestra una vez
ADMIN_PASSWORD=

# Minutos sin actividad antes de pedir acceso de nuevo
IDLE_MINUTES=15
# Si el sistema está detrás de un proxy inverso (nginx, etc.) poner 1; si no, dejar vacío
TRUST_PROXY=